<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout so we can overlay the left-accent bar on the content row -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <!-- Left unread accent bar (hidden when item is read via adapter) -->
    <View
        android:id="@+id/notifAccentBar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/purple_accent"
        android:visibility="gone" />

    <!-- Content row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingVertical="14dp">

        <!-- Type-colored icon circle -->
        <FrameLayout
            android:id="@+id/notifIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_purple">

            <TextView
                android:id="@+id/notifIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎮"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Text block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notifMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mensaje"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notifTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Hace 1 min"
                android:textColor="@color/purple_accent"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Unread dot -->
        <View
            android:id="@+id/notifUnreadDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
