<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating frosted-glass nav dock -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/custom_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_nav_blur"
        android:clipToOutline="true"
        android:elevation="16dp"
        app:blurOverlayColor="#CC0F0E17"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Home tab -->
            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/nav_home_pill"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_nav_item_active">
                    <ImageView
                        android:id="@+id/nav_home_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_home"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_home_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Home"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />
            </LinearLayout>

            <!-- Request tab -->
            <LinearLayout
                android:id="@+id/nav_request"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/nav_request_pill"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent">
                    <ImageView
                        android:id="@+id/nav_request_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_request"
                        app:tint="@color/text_muted" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_request_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Request"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.03" />
            </LinearLayout>

            <!-- Profile tab -->
            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/nav_profile_pill"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent">
                    <ImageView
                        android:id="@+id/nav_profile_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_profile"
                        app:tint="@color/text_muted" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_profile_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Settings"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.03" />
            </LinearLayout>

        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>

</androidx.constraintlayout.widget.ConstraintLayout>
